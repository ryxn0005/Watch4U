# Copy to .env and fill in real values

# Server
APP_ENV=development
LOG_LEVEL=INFO

# CORS — comma-separated origins for the Streamlit / Next.js UI
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# LLM (RAG) — placeholder for whichever provider Ryan picks (Ollama / OpenAI / etc.)
LLM_PROVIDER=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Vector store — placeholder for RAG (e.g. Chroma, Qdrant, pgvector)
VECTOR_DB_URL=

# Data paths (mounted from ../data via docker-compose)
DATA_DIR=/data

# SurrealDB — leave SURREAL_URL empty to run API without DB; use docker-compose.surreal.yml (port 8080)
SURREAL_URL=ws://127.0.0.1:8080
SURREAL_USERNAME=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=watch4u
SURREAL_DATABASE=main
SURREAL_APPLY_SCHEMA_ON_STARTUP=true
